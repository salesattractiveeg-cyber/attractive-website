    align-items: center;
    gap: 8px;
    line-height: normal;
     }
 .Sub-product-menu-wrap .Sub-product-menu-wr .Sub-product-menu-list a{
      padding: 5px 10px;
    background-color: #f5f6f7;
 }
 .Sub-product-menu-wrap .Sub-product-menu-wr .Sub-product-menu-list a img{
        filter: brightness(0);
    height: 18px;
 }
 .pord-nav:has(> .Sub-product-menu-wrap),.sol-nav:has(> .Sub-product-menu-wrap),.supp-nav:has(> .Sub-product-menu-wrap),.par-nav:has(> .Sub-product-menu-wrap)  {
  top: 4.875rem;
}
  @media (max-width: 1500px) {
    .Sub-product-menu-wrap {
      padding: 0 5%;
    }
  }
</style>
<script>
   /*用于解决下拉菜单过长，无法滚动的问题，当鼠标滚动超过120px时，触发隐藏子产品板块，并缩小下拉菜单的top值。2026-06-02 joe*/
$(function() {
    var NAV_CLASSES = ['pord-nav', 'sol-nav', 'supp-nav', 'par-nav'];
    var SCROLL_THRESHOLD = 120;
    var TOP_EXPANDED = '4.875rem';
    var TOP_COLLAPSED = '1.875rem';
    var SUB_MENU_CLASS = 'Sub-product-menu-wrap';
    var isTicking = false;
    /**
     * 检测元素的 style 属性中是否包含 display: block
     */
    function hasDisplayBlock($element) {
        var styleAttr = $element.attr('style') || '';
        return /display:\s*block/i.test(styleAttr);
    }
    function updateDropdownState() {
        var scrollY = window.scrollY || document.documentElement.scrollTop;
        var isScrolled = scrollY > SCROLL_THRESHOLD;
        var selectors = NAV_CLASSES.map(function(cls) {
            return 'div.' + cls;
        }).join(', ');
        $(selectors).each(function() {
            var $panel = $(this);
            // 【核心修正】只有 style 包含 display: block 时才处理
            // 下拉菜单未展开时（无 display: block），完全跳过
            if (!hasDisplayBlock($panel)) {
                return;
            }
            var $subMenu = $panel.children('.' + SUB_MENU_CLASS);
            if (isScrolled) {
                // 滚动 > 120px：收缩 top，隐藏子菜单
                $panel.css('top', TOP_COLLAPSED);
                $subMenu.css('display', 'none');
            } else {
                // 滚动 < 120px：恢复 top，子菜单恢复默认
                $panel.css('top', TOP_EXPANDED);
                $subMenu.css('display', '');  // 删除 display 属性
            }
        });
        isTicking = false;
    }
    function onScroll() {
        if (!isTicking) {
            requestAnimationFrame(updateDropdownState);
            isTicking = true;
        }
    }
    $(window).on('scroll', onScroll);
});</script>
