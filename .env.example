# Copy these into Vercel -> Settings -> Environment Variables (NEVER commit real values).

# Admin password for /admin.html. 32+ random characters. Server-side only.
ADMIN_API_SECRET=

# Encrypts accounts + orders and derives their storage paths. 32+ random characters. Set it ONCE and never change it
# (changing it makes existing accounts/orders unreadable). Independent of the admin password.
DATA_KEY=

# Enables "Sign in with Google". Public id from Google Cloud Console (looks like 123-abc.apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional; defaults to the current Graph API version supported by the integration.
FACEBOOK_GRAPH_VERSION=

# Optional. Google Apps Script URL for server-side order export; never stored in public store data.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional ------------------------------------------------------------------------------------------------
# Only while importing accounts from the very first version: the OLD admin password. Remove after the import.
LEGACY_ADMIN_SECRET=
# 1 = a customer who first used e-mail+password and then clicks "Sign in with Google" keeps the password too.
# Default (empty) revokes the password at that moment, which blocks e-mail squatting. See DEPLOY.md.
GOOGLE_KEEP_PASSWORD=

# Added automatically when you connect a Blob store in Vercel -> Storage:
# BLOB_READ_WRITE_TOKEN=
